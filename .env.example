# ---------------------------------------------------------------------------
# Environment template for the SQL Quiz System.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`
# (it is gitignored). All values below are placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL (db service) ---
DB_USER=sqlquiz
DB_PASSWORD=change-me-strong-db-password
DB_NAME=sqlquiz

# --- Backend database connection ---
# Must point at the db service using the credentials above.
# Format: postgres://<DB_USER>:<DB_PASSWORD>@<host>:5432/<DB_NAME>?sslmode=disable
DATABASE_URL=postgres://sqlquiz:change-me-strong-db-password@db:5432/sqlquiz?sslmode=disable

# --- Auth ---
# Long random string used to sign JWTs. Generate with e.g. `openssl rand -base64 48`.
# The backend refuses to start if this is unset.
JWT_SECRET=change-me-long-random-jwt-secret

# --- Seed administrator account (created on first startup only) ---
# ADMIN_USER is the login. ADMIN_EMAIL receives the server-generated admin
# password once, by email, at first seed (and is stored on the account so the
# admin can use forgot-password). The password is NOT set by hand; if ADMIN_EMAIL
# is unset it is printed to the backend log at first seed instead.
ADMIN_USER=admin
ADMIN_EMAIL=author@example.com

# --- Password-event encryption (AES-256-GCM) ---
# base64 of exactly 32 random bytes. Generate with `openssl rand -base64 32`.
# If unset, password-event logging (the admin changelog) is disabled; login and
# password changes still work.
PASSWORD_LOG_KEY=change-me-base64-32-byte-key

# --- Email delivery (Gmail SMTP) ---
# Sender Gmail address and a Gmail App Password (16 chars, requires 2FA on that
# account). If EMAIL_SENDER_ADDRESS is unset the app uses a no-op sender that
# only logs "TODO: email ..." instead of sending.
EMAIL_SENDER_ADDRESS=your-sender@gmail.com
EMAIL_SENDER_APP_PASSWORD=your-gmail-app-password
# Optional SMTP overrides (defaults: smtp.gmail.com / 587 STARTTLS)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587

# Address that receives password-change notifications. Optional.
ADMIN_NOTIFY_EMAIL=admin-notify@example.com

# --- Submission-log export emailer ---
# Emails a gzip-CSV delta of exam + practice submissions to the admin on an interval.
# Requires EMAIL_SENDER_ADDRESS (SMTP) to be configured, else the exporter does not start.
SUBMISSION_EXPORT_ENABLED=true          # first-boot default; after that the admin UI toggle wins
SUBMISSION_EXPORT_INTERVAL=24h          # Go duration (e.g. 24h, 12h, 30m); default 24h
EXPORT_ADMIN_EMAIL=                     # recipient; falls back to ADMIN_EMAIL when empty
