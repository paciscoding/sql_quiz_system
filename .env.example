# ---------------------------------------------------------------------------
# Environment template for the SQL Quiz System.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`
# (it is gitignored). All values below are placeholders.
# ---------------------------------------------------------------------------

# --- PostgreSQL (db service) ---
DB_USER=sqlquiz
DB_PASSWORD=change-me-strong-db-password
DB_NAME=sqlquiz

# --- Backend database connection ---
# Must point at the db service using the credentials above.
# Format: postgres://<DB_USER>:<DB_PASSWORD>@<host>:5432/<DB_NAME>?sslmode=disable
DATABASE_URL=postgres://sqlquiz:change-me-strong-db-password@db:5432/sqlquiz?sslmode=disable

# --- Restricted student-SQL login role (ARCH-025) — REQUIRED ---
# Password for the `quiz_exec` Postgres role. Every student SQL statement runs
# as this NOSUPERUSER/NOCREATEROLE/NOINHERIT role, which is the sandbox
# boundary (SET ROLE postgres and reads of app.system_users both denied).
# The backend log.Fatal-s on boot if this is unset.
# This is the SINGLE SOURCE OF TRUTH: the backend creates/updates the quiz_exec
# role with THIS password at boot (CreateRestrictedUser), so a fresh volume just
# works — no external script needed. (On a de-privileged app role that cannot
# create roles, provision quiz_exec out of band with
# scripts/deprivilege_app_db_user.sql and keep this value matching it.)
# Generate: openssl rand -base64 32
STUDENT_DB_PASSWORD=change-me-quiz-exec-password

# --- Auth ---
# Long random string used to sign JWTs. Generate with e.g. `openssl rand -base64 48`.
# The backend refuses to start if this is unset.
JWT_SECRET=change-me-long-random-jwt-secret

# --- Public resource-id tokens (opaque sqids) ---
# Long random string (like JWT_SECRET) that deterministically shuffles the
# alphabet used to encode/decode public resource ids (exam/user/practice/etc
# ids exposed over the API). Generate with `openssl rand -base64 32`. The
# backend refuses to start if this is unset. Changing it invalidates every
# previously-issued resource-id URL/token (they are ephemeral by design).
ID_SALT=change-me-long-random-id-salt

# --- CORS: browser origins allowed to call the API ---
# Comma-separated scheme+host(:port) the frontend is served from; must match
# exactly what users type in the browser. Behind the nginx TLS proxy the browser
# Origin is the server's https URL. docker-compose falls back to https://localhost
# when this is unset.
ALLOWED_ORIGINS=https://10.4.29.203

# --- Seed administrator account (created on first startup only) ---
# ADMIN_USER is the login. ADMIN_EMAIL receives the server-generated admin
# password once, by email, at first seed (and is stored on the account so the
# admin can use forgot-password). The password is NOT set by hand; if ADMIN_EMAIL
# is unset it is printed to the backend log at first seed instead.
ADMIN_USER=admin
ADMIN_EMAIL=author@example.com

# --- Password-event encryption (AES-256-GCM) ---
# base64 of exactly 32 random bytes. Generate with `openssl rand -base64 32`.
# If unset, password-event logging (the admin changelog) is disabled; login and
# password changes still work.
PASSWORD_LOG_KEY=change-me-base64-32-byte-key

# --- Email delivery (Gmail SMTP) ---
# Sender Gmail address and a Gmail App Password (16 chars, requires 2FA on that
# account). If EMAIL_SENDER_ADDRESS is unset the app uses a no-op sender that
# only logs "TODO: email ..." instead of sending.
EMAIL_SENDER_ADDRESS=your-sender@gmail.com
EMAIL_SENDER_APP_PASSWORD=your-gmail-app-password
# Optional SMTP overrides (defaults: smtp.gmail.com / 587 STARTTLS)
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587

# --- Public email-based forgot-password flow ---
# Gates POST /api/v1/forgot-password and /forgot-password/verify (the student-
# facing "email me a code" flow). DEFAULTS TO DISABLED: unset, empty, or any
# non-truthy value keeps it off, and both routes answer a constant 404 telling
# the user to contact their administrator. Leave it off unless SMTP delivery is
# verified working — otherwise the flow silently goes nowhere.
# Admins reset passwords from the admin UI instead (Users → Reset password),
# which generates a password, shows it on screen, and needs no email at all.
# Set to true/1 to re-enable the public flow; no code change is needed.
PASSWORD_RESET_EMAIL_ENABLED=false

# Address that receives password-change notifications. Optional.
ADMIN_NOTIFY_EMAIL=admin-notify@example.com

# --- Submission-log export emailer ---
# Emails a gzip-CSV delta of exam + practice submissions to the admin on an interval.
# Requires EMAIL_SENDER_ADDRESS (SMTP) to be configured, else the exporter does not start.
SUBMISSION_EXPORT_ENABLED=true          # first-boot default; after that the admin UI toggle wins
SUBMISSION_EXPORT_INTERVAL=24h          # Go duration (e.g. 24h, 12h, 30m); default 24h
EXPORT_ADMIN_EMAIL=                     # recipient; falls back to ADMIN_EMAIL when empty

DUCKDNS_TOKEN=
