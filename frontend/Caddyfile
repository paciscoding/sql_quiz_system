# ==========================================
# REUSABLE TLS SNIPPET
# ==========================================
(duckdns_tls) {
    tls {
        dns duckdns {$DUCKDNS_TOKEN}
        propagation_delay 30s
    }
}

# ==========================================
# SINGLE-DOMAIN SERVER CONFIGURATION
# ==========================================
sql-cscmu.duckdns.org {
    import duckdns_tls

    # Automatic Gzip & Zstd Compression
    encode gzip zstd

    # Security Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
        Content-Security-Policy "default-src 'self' http: https: data: blob: 'unsafe-inline'; frame-ancestors 'self';"
    }

    # ------------------------------------------
    # 1. SSE (Server-Sent Events) Stream Route
    # ------------------------------------------
    # Matches: /api/v1/quiz/exams/<number>/stream
    @sse_stream path_regexp sse ^/api/v1/quiz/exams/[0-9]+/stream$
    
    handle @sse_stream {
        reverse_proxy http://backend:8080 {
            # Disables response buffering so SSE events stream in real-time
            flush_interval -1
        }
    }

    # ------------------------------------------
    # 2. General REST API Proxy Route
    # ------------------------------------------
    # Forwards all /api/* requests to the Go backend
    handle /api/* {
        reverse_proxy http://backend:8080 {
            # Strips WebSocket headers for standard REST endpoints
            header_up Upgrade ""
            header_up Connection ""
        }
    }

    # ------------------------------------------
    # 3. Static Assets & SPA Fallback Route
    # ------------------------------------------
    # Catches everything else (frontend app)
    handle {
        root * /usr/share/nginx/html

        # Caching rule for static media/assets (30 days)
        @static path_regexp static \.(?:ico|css|js|gif|jpe?g|png|svg|woff2?)$
        header @static Cache-Control "public, max-age=2592000, no-transform"

        # Serve static files, fallback to index.html for client-side SPA routes
        try_files {path} {path}/ /index.html
        file_server
    }
}
