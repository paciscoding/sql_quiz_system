erDiagram
    %% All system tables live in the `app` schema.
    %% Curriculum tables (e.g. Elmasri company) live in `public` and are
    %% cloned into per-student `student_{id}` schemas via
    %% CREATE TABLE ... (LIKE public.x INCLUDING ALL) + INSERT SELECT.

    APP_SYSTEM_USERS ||--o{ APP_EXAMINATIONS : "creates"
    APP_SYSTEM_USERS ||--o{ APP_SYSTEM_USERS : "manages"
    APP_SYSTEM_USERS ||--o{ APP_EXAM_STUDENTS : "enrolls"
    APP_EXAMINATIONS ||--o{ APP_QUESTIONS : "contains"
    APP_EXAMINATIONS ||--o{ APP_EXAM_STUDENTS : "has"

    APP_SYSTEM_USERS {
        int id PK
        string username
        string password_hash
        string role
        int created_by FK
        timestamp created_at
    }

    APP_EXAMINATIONS {
        int id PK
        string title
        boolean is_active
        int created_by FK
        timestamp created_at
    }

    APP_QUESTIONS {
        int id PK
        int exam_id FK
        string target_table
        string correct_sql
        string question_type
        double points
        boolean strict_ordering
        boolean strict_attributes
        boolean strict_record_order
    }

    APP_EXAM_STUDENTS {
        int exam_id PK_FK
        int student_id PK_FK
    }
