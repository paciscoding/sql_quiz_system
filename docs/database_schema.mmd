    APP_SYSTEM_USERS {
        int id PK
        string username
        string password_hash
        string role
        int created_by FK
        timestamp created_at
        string student_number
        string student_id_ext
        string sec_lec
        string sec_lab
        string first_name
        string last_name
    }

    APP_EXAMINATIONS {
        int id PK
        string title
        boolean is_active
        int created_by FK
        timestamp created_at
        timestamp activated_at
        timestamp archived_at
        boolean block_practice_during_exam
    }

    APP_QUESTIONS {
        int id PK
        int exam_id FK
        int created_by FK
        string question_type
        string target_table
        string correct_sql
        double points
        string requirement
        boolean strict_ordering
        boolean strict_attributes
        jsonb expected_result
        jsonb expected_columns
        string expected_result_status
        timestamp expected_result_captured_at
        text capture_error
        timestamp created_at
        timestamp updated_at
    }

    APP_EXAM_STUDENTS {
        int exam_id PK
        int student_id PK
        int assigned_by FK
        timestamp assigned_at
    }

    APP_SUBMISSIONS {
        bigint id PK
        int exam_id FK
        int student_id FK
        int question_id FK
        text sql_text
        boolean is_correct
        double score
        jsonb validation_details
        timestamp submitted_at
    }

    APP_EXAM_SANDBOXES {
        int exam_id PK
        string schema_name
        timestamp created_at
        timestamp dropped_at
    }

    APP_PRACTICE_CATEGORIES {
        int id PK
        string name UK
        string schema_name UK
        int created_by FK
        timestamp created_at
        timestamp updated_at
    }
    APP_PRACTICE_QUESTIONS {
        int id PK
        int created_by FK
        int category_id FK
        string category "legacy, deprecated"
        text target_table
        text correct_sql
        text question_type
        text requirement
        numeric points
        boolean strict_ordering
        boolean strict_attrs
        jsonb expected_result
        jsonb expected_columns
        text expected_result_status
        text capture_error
        timestamp expected_result_captured_at
        timestamp created_at
        timestamp updated_at
    }

    APP_PRACTICE_ATTEMPTS {
        int id PK
        int student_id FK
        int practice_question_id FK
        text sql_text
        boolean is_correct
        jsonb validation_details
        timestamp submitted_at
    }
